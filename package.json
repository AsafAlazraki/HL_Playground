{
  "name": "helmlogic-dynamic-config",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "npm run check:types && npm run lint && vitest run && npm run check:reachable && npm run check:styles && npm run check:words && npm run check:stores",
    "test:watch": "vitest",
    "check:reachable": "node tools/check-reachability.mjs",
    "check:styles": "node tools/check-styles.mjs",
    "check:types": "tsc --noEmit -p tsconfig.app.json",
    "check:contrast": "node tools/check-contrast.mjs",
    "check:shots": "node tools/check-shots.mjs",
    "lint": "oxlint src tools --max-warnings 343",
    "lint:fix": "oxlint src tools --fix",
    "check:words": "node tools/check-words.mjs",
    "check:stores": "node tools/check-stores.mjs",
    "check:collide": "node tools/check-collide.mjs"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@xyflow/react": "^12.11.2",
    "dexie": "^4.4.4",
    "motion": "^13.0.0",
    "nanoid": "^6.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@playwright/mcp": "^0.0.80",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "happy-dom": "^20.14.0",
    "oxlint": "1.82",
    "playwright": "^1.63.0",
    "playwright-core": "^1.63.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=22"
  }
}
