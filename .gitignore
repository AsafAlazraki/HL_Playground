# dependencies and build output
node_modules
dist

# TypeScript incremental build state — machine-specific, never shared
*.tsbuildinfo

# local tool output
.playwright-mcp
*.local

# per-machine editor/agent settings (launch.json IS committed — it is how a
# collaborator starts the dev server on the right port)
.claude/settings.local.json

.DS_Store
Thumbs.db

# Python bytecode from the seed generator — machine and version specific
__pycache__/
*.pyc

# agent screenshots — never committed; they belong in the scratchpad
*.png

# the originals tools/seed/fetch_images.py downloaded, kept so re-encoding at a
# different size costs nobody else's bandwidth. 17 MB, machine-local; the
# DOWNSCALED copies under public/seed-images are the ones that are committed.
tools/seed/.imgcache/
